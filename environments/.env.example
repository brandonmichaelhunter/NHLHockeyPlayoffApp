### Example environment variables for local development
# Copy this file to `.env.development` (do NOT commit secrets).

# Database connection URL
DATABASE_URL=

# Optional: other runtime values
#SECRET_KEY=
#REDIS_URL=

# Notes:
# - Do not commit the real `.env.development` or other env files.
# - Use `docker run --env-file ./environments/.env.development ...` to pass these to the container.
